{
  "name": "travel-platform",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve platform-admin --port 4200",
    "start:platform": "ng serve platform-admin --port 4200",
    "start:tenant": "ng serve tenant-admin --port 4201",
    "start:platform:prod": "ng serve platform-admin --configuration production --port 4200",
    "start:tenant:prod": "ng serve tenant-admin --configuration production --port 4201",
    "build": "ng build",
    "build:all": "ng build admin-core && ng build platform-admin && ng build tenant-admin",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@primeuix/themes": "^3.1.1",
    "material-symbols": "^0.48.3",
    "primeng": "^22.1.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
